# Lets the site open at http://host/itsupportz/ (no /public in the URL)
# and makes sure nothing outside public/ (.env, app/, writable/, system/) can ever be downloaded.
Options -Indexes

# Never serve dot-files such as .env or .git, even if rewriting is unavailable.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep application and dependency files outside the public web root.
    RewriteRule ^(?:app|system|writable|vendor|tests|build|node_modules|\.git)(?:/|$) - [F,L,NC]

    # Do not rewrite requests into public/ a second time.
    RewriteRule ^public(?:/|$) - [L]

    # Send every request into public/; public/.htaccess then routes it to index.php.
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Without mod_rewrite the project root must not be browsable at all.
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
